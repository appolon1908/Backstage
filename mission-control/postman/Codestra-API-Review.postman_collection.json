{
  "info": {
    "_postman_id": "codestra-api-review-safe-certification-v1",
    "name": "Codestra API Review - Safe Certification",
    "description": "Safe-by-default API review orchestrator. Source authority remains in Middleware, Kong, and Caddy collections. Non-effectful folders use GET-only probes. Folder 90 Effectful Negative Tests is disabled unless RUN_EFFECTFUL=true. No production effect is authorized by this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "mission_control_url",
      "value": "http://127.0.0.1:8765"
    },
    {
      "key": "middleware_url",
      "value": "http://127.0.0.1:8095"
    },
    {
      "key": "kong_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "caddy_url",
      "value": "https://127.0.0.1:9443"
    },
    {
      "key": "bearer_token",
      "value": ""
    },
    {
      "key": "wrong_audience_token",
      "value": ""
    },
    {
      "key": "tenant_id",
      "value": "TEST_SYN"
    },
    {
      "key": "correlation_id",
      "value": "TEST_SYN-postman-review"
    },
    {
      "key": "RUN_EFFECTFUL",
      "value": "false"
    },
    {
      "key": "middleware_source_sha",
      "value": "2862af0aa97367b18cb360af69212abe4243a1ac"
    },
    {
      "key": "kong_source_sha",
      "value": "3e68cb2a4955bd71ddb3e839f4d9e3770465fc08"
    },
