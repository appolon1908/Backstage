  "item": [
    {
      "name": "00 Preflight",
      "item": [
        {
          "name": "Mission Control health",
          "request": {
            "method": "GET",
            "url": "{{mission_control_url}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Mission Control health is 200',()=>pm.response.to.have.status(200));",
                  "pm.test('Mission Control reports ok=true',()=>pm.expect(pm.response.json().ok).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Middleware kernel describe",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{correlation_id}}"
              }
            ],
            "url": "{{middleware_url}}/platform/v1/kernel/describe"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Middleware does not return 5xx',()=>pm.expect(pm.response.code).to.be.below(500));",
                  "if(pm.variables.replaceIn('{{bearer_token}}')){pm.test('Authenticated Middleware succeeds',()=>pm.expect(pm.response.code).to.be.within(200,299));}"
                ]
              }
            }
          ]
        },
        {
          "name": "Kong kernel describe",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{correlation_id}}"
              }
            ],
            "url": "{{kong_url}}/platform/v1/kernel/describe"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Kong does not return 5xx',()=>pm.expect(pm.response.code).to.be.below(500));",
                  "if(pm.variables.replaceIn('{{bearer_token}}')){pm.test('Authenticated Kong succeeds',()=>pm.expect(pm.response.code).to.be.within(200,299));}"
                ]
              }
            }
          ]
        },
        {
          "name": "Caddy kernel describe",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{correlation_id}}"
              }
            ],
            "url": "{{caddy_url}}/platform/v1/kernel/describe"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Caddy edge does not return 5xx',()=>pm.expect(pm.response.code).to.be.below(500));",
                  "if(pm.variables.replaceIn('{{bearer_token}}')){pm.test('Authenticated Caddy edge succeeds',()=>pm.expect(pm.response.code).to.be.within(200,299));}"
                ]
              }
            }
          ]
        }
      ]
    },
