    {
      "name": "90 Effectful Negative Tests - Disabled by Default",
      "item": [
        {
          "name": "Caddy automation wrong-audience denial",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if(pm.variables.replaceIn('{{RUN_EFFECTFUL}}')!=='true'){pm.execution.skipRequest();}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('wrong audience denied',()=>pm.expect(pm.response.code).to.be.oneOf([401,403,404]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{wrong_audience_token}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{correlation_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{caddy_url}}/v2/automation/commands"
          }
        },
        {
          "name": "Kong automation wrong-audience denial",
          "event": [
            {
              "listen": "prerequest",
              "script": {
